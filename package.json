{
  "name": "dsh-disable-unofficial-plugins",
  "version": "1.1.0",
  "description": "DSH Web UI plugin: 在「插件 → 已安装」分组标题行最右侧加一个勾选式开关，可选择停用/启用哪些非官方插件（默认全选、只停用不卸载；全部停用后按钮翻转为启用侧）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhatCannotBeSaid/dsh-disable-unofficial-plugins.git"
  },
  "homepage": "https://github.com/WhatCannotBeSaid/dsh-disable-unofficial-plugins#readme",
  "bugs": {
    "url": "https://github.com/WhatCannotBeSaid/dsh-disable-unofficial-plugins/issues"
  },
  "author": "WhatCannotBeSaid",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "web-ui"
  ],
  "license": "MIT"
}
